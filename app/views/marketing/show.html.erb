                  <a href="https://www.linkedin.com/in/<%= expert[:linkedin] %>" style="margin-top: 10px" target="_blank">
                    <%= image_tag "social/linkedin.svg", class: "w-5 h-5", alt: "LinkedIn" %>
                  </a>
                <% end %>
              </div>
              <p class="text-md text-secondary-700 mb-3">
                <%= expert[:expertise].map { |e| content_tag(:span, e, class: "txt-nowrap") }.join("&nbsp;• ").html_safe %>
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

